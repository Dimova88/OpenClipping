# ── OpenClipping configuration ───────────────────────────────────────────────
# Every field is OPTIONAL. With none of them the app still runs fully offline.

# AI transcription + virality analysis (free tier is fine).
# Get a key free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Prefer fully-local transcription (needs `pip install faster-whisper` and one
# model download). Zero API calls — ideal for volume on a VPS.
PREFER_LOCAL_WHISPER=false
WHISPER_MODEL=base.en

# ── Publishing accounts (all free to create as a developer) ─────────────────
# Instagram: create a Meta app (developers.facebook.com, Business type) with the
#   Instagram product; scopes requested automatically on connect.
IG_CLIENT_ID=
IG_CLIENT_SECRET=

# TikTok: create an app at developers.tiktok.com, enable Content Posting API,
#   scope video.publish. Unaudited apps post private-only until TikTok audit.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# YouTube: path to an OAuth client_secrets.json from console.cloud.google.com
YT_CLIENT_SECRET=

# OAuth return address. Must match your app's registered redirect URI.
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Public HTTPS base URL of this server. Used for Instagram video_url fallback
# and (optionally) TikTok URL-pull. Leave blank to use resumable upload instead.
PUBLIC_BASE_URL=

# ── Tuning (sane defaults; leave blank) ─────────────────────────────────────
CLIPS_PER_VIDEO=5
CLIP_MIN_SEC=18
CLIP_MAX_SEC=90
OUT_WIDTH=1080
OUT_HEIGHT=1920
OUT_PRESET=veryfast
OUT_CRF=20
CAPTION_STYLE=bold_pop
REFRAME_ANALYSIS_FPS=4
POSTS_PER_DAY=3
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO
